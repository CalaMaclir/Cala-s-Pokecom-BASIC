10 REM CREATE CPB094TEST DIRECTORY IN FILES BEFORE RUNNING
20 REM 50 CYCLES PER RUN; TAKE INFO AND SERIAL BETWEEN BATCHES
30 SCREEN 320,320
40 N=50
50 FOR I=1 TO N
60 CLS
70 COLOR 255,0,0
80 BOX 8,8,40,40,1
90 C=POINT(10,10)
100 SAVEIMAGE "/CPB094TEST/ROUNDTRIP.BMP"
110 SAVE IMAGE "/CPB094TEST/LEGACY.BMP"
120 CLS
130 LOADIMAGE "/CPB094TEST/ROUNDTRIP.BMP",0,0
140 IF POINT(10,10)<>C THEN GOTO 900
150 CLS
160 LOADIMAGE "/CPB094TEST/LEGACY.BMP",0,0
170 IF POINT(10,10)<>C THEN GOTO 900
180 NEXT I
190 PRINT "IMAGE CYCLES OK: ";N
200 END
900 PRINT "IMAGE CHECK FAILED AT ";I
910 STOP
