DATA 1,2,3,4,5
SUM=0
DO
    READ A
    SELECT CASE A
    CASE 1
        PRINT "ONE"
    CASE 2,3
        PRINT "TWO OR THREE"
    CASE 4 TO 10
        PRINT "FOUR PLUS"
    CASE ELSE
        PRINT "OTHER"
    END SELECT
    SUM=SUM+A
    IF A=5 THEN EXIT DO
LOOP
PRINT "SUM=";SUM
RESTORE
READ A
PRINT "RESTORE=";A
END
