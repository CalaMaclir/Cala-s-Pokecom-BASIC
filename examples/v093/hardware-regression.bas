REM Stage 4: combined Stage 3 regression. Expected: STAGE3 PASS
F=0
IF ABS(LOG(100)-2)>0.0001 THEN F=F+1
IF ABS(LN(EXP(1))-1)>0.0001 THEN F=F+1
IF ABS(DEG(ASIN(1))-90)>0.0001 THEN F=F+1
IF ABS(DEG(ACOS(0))-90)>0.0001 THEN F=F+1
IF ABS(DEG(ATAN2(1,0))-90)>0.0001 THEN F=F+1
IF (17\5)<>3 THEN F=F+1
IF (1<<4)<>16 THEN F=F+1
IF (16>>2)<>4 THEN F=F+1
IF (5 XOR 3)<>6 THEN F=F+1
DATA 1,2,3,4,5
S=0
DO
    READ A
    SELECT CASE A
    CASE 1
        S=S+1
    CASE 2,3
        S=S+A
    CASE 4 TO 5
        S=S+A
    CASE ELSE
        F=F+1
    END SELECT
    IF A=5 THEN EXIT DO
LOOP
IF S<>15 THEN F=F+1
RESTORE
READ A
IF A<>1 THEN F=F+1
FOR I=1 TO 10
    IF I=3 THEN EXIT FOR
NEXT I
IF I<>3 THEN F=F+1
IF F=0 THEN PRINT "STAGE3 PASS"
IF F<>0 THEN PRINT "STAGE3 FAIL ";F
END
