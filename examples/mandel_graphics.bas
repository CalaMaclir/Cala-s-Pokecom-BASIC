10 CLS
20 MAX=100
25 XS=3.2/319:YS=2.4/239
30 FOR Y=40 TO 279
40 CI=-1.2+(Y-40)*YS
50 FOR X=0 TO 319
60 CR=-2.2+X*XS
70 XR=0:XI=0
80 I=0
90 FOR I=0 TO MAX
100 XT=XR*XR-XI*XI+CR
110 XI=2*XR*XI+CI
120 XR=XT
130 IF XR*XR+XI*XI>4 THEN GOTO 160
140 NEXT I
150 I=MAX
160 R=MIN(255,I*9)
170 G=MIN(255,I*7)
180 B=MIN(255,I*5)
190 COLOR R,G,B
200 PSET X,Y
210 NEXT X
220 IF (Y-40) MOD 8=0 THEN FLUSH
230 NEXT Y
240 FLUSH
250 END
