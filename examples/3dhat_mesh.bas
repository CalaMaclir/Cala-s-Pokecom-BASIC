10 REM 3D HAT - RETROMINIBASIC PICOCALC
20 REM CLASSIC MEXICAN-HAT SURFACE, ADAPTED FOR 320X320
30 CLS
40 COLOR 0,0,0
50 BOX 0,0,319,319,1
60 REM DRAW HORIZONTAL MESH LINES
70 FOR Y=-180 TO 180 STEP 6
80 H=INT((Y+180)*255/360)
90 COLOR 40+INT(H*0.5),255-H,128+INT(H*0.4)
100 X=-180
110 R=3.14159265358979/180*SQR(X*X+Y*Y)
120 Z=100*COS(R)-30*COS(3*R)
130 PX=INT(160+X*0.56-Y*0.28)
140 PY=INT(175-Y*0.37-Z*0.72)
150 FOR X=-174 TO 180 STEP 6
160 R=3.14159265358979/180*SQR(X*X+Y*Y)
170 Z=100*COS(R)-30*COS(3*R)
180 SX=INT(160+X*0.56-Y*0.28)
190 SY=INT(175-Y*0.37-Z*0.72)
200 LINE (PX,PY)-(SX,SY)
210 PX=SX:PY=SY
220 NEXT X
230 FLUSH
240 NEXT Y
250 REM DRAW SPARSE CROSS-MESH FOR DEPTH
260 COLOR 80,160,255
270 FOR X=-180 TO 180 STEP 18
280 Y=-180
290 R=3.14159265358979/180*SQR(X*X+Y*Y)
300 Z=100*COS(R)-30*COS(3*R)
310 PX=INT(160+X*0.56-Y*0.28)
320 PY=INT(175-Y*0.37-Z*0.72)
330 FOR Y=-174 TO 180 STEP 6
340 R=3.14159265358979/180*SQR(X*X+Y*Y)
350 Z=100*COS(R)-30*COS(3*R)
360 SX=INT(160+X*0.56-Y*0.28)
370 SY=INT(175-Y*0.37-Z*0.72)
380 LINE (PX,PY)-(SX,SY)
390 PX=SX:PY=SY
400 NEXT Y
410 NEXT X
420 FLUSH
430 END
