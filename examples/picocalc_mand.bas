10 REM PICOCALC BUNDLED MANDELBROT PORT
20 CLS
30 W=320:H=320
40 XMIN=-2:XMAX=1
50 YMIN=-1.5:YMAX=1.5
60 MAXITER=16
65 XS=(XMAX-XMIN)/W:YS=(YMAX-YMIN)/H:GS=255/MAXITER
70 FOR Y=0 TO H-1
80 CY=YMIN+YS*Y
90 FOR X=0 TO W-1
100 CX=XMIN+XS*X
110 ZX=0:ZY=0:I=0
120 FOR J=1 TO MAXITER
130 ZXNEXT=ZX*ZX-ZY*ZY+CX
140 ZY=2*ZX*ZY+CY
150 ZX=ZXNEXT
160 I=J
170 IF ZX*ZX>4 OR ZY*ZY>4 THEN GOTO 200
180 NEXT J
190 I=MAXITER
200 G=INT(GS*I)
210 COLOR G,G,G
220 PSET X,Y
230 NEXT X
240 NEXT Y
250 END
