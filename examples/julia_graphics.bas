10 REM JULIA SET - PICOCALC NATIVE 320X240
20 CLS
30 MAXITER=120
40 CR=-0.7
50 CI=0.27015
60 XS=3.2/319
70 YS=2.4/239
80 FOR Y=40 TO 279
90 Y0=-1.2+(Y-40)*YS
100 FOR X=0 TO 319
110 X0=-2.2+X*XS
120 XR=X0
130 XI=Y0
140 I=0
150 FOR I=0 TO MAXITER
160 XT=XR*XR-XI*XI+CR
170 XI=2*XR*XI+CI
180 XR=XT
190 IF XR*XR+XI*XI>4 THEN GOTO 220
200 NEXT I
210 I=MAXITER
220 R=MIN(255,I*5)
230 G=MIN(255,I*9)
240 B=MIN(255,I*3)
250 COLOR R,G,B
260 PSET X,Y
270 NEXT X
280 IF (Y-40) MOD 8=0 THEN FLUSH
290 NEXT Y
300 FLUSH
310 END
