10 REM Lissajous Gallery for Cala's Pokecom BASIC
20 SCREEN 320,320
30 CLS
40 DT=0.025
50 REM ----- TOP ROW -----
60 CX=53:CY=52:RX=44:RY=40:A=5:B=4:PH=0
70 CR=0:CG=255:CB=110:GOSUB 1000
80 CX=160:CY=52:RX=44:RY=40:A=4:B=3:PH=0
90 CR=255:CG=170:CB=120:GOSUB 1000
100 CX=267:CY=52:RX=44:RY=40:A=3:B=2:PH=0
110 CR=255:CG=230:CB=190:GOSUB 1000
120 REM ----- MIDDLE ROW -----
130 CX=53:CY=154:RX=44:RY=40:A=2:B=3:PH=0
140 CR=255:CG=150:CB=120:GOSUB 1000
150 CX=160:CY=154:RX=44:RY=40:A=3:B=4:PH=0
160 CR=255:CG=50:CB=80:GOSUB 1000
170 CX=267:CY=154:RX=44:RY=40:A=4:B=5:PH=0
180 CR=255:CG=40:CB=220:GOSUB 1000
190 REM ----- BOTTOM ROW -----
200 CX=53:CY=260:RX=43:RY=39:A=1:B=1:PH=1.5708
210 CR=0:CG=255:CB=210:GOSUB 1000
220 CX=160:CY=260:RX=43:RY=39:A=2:B=1:PH=0
230 CR=255:CG=70:CB=255:GOSUB 1000
240 CX=267:CY=260:RX=43:RY=39:A=3:B=2:PH=0
250 CR=40:CG=100:CB=255:GOSUB 1000
260 FLUSH
265 PAUSE
270 END
1000 REM ----- DRAW LISSAJOUS -----
1010 COLOR CR,CG,CB
1020 T=0
1030 X0=INT(CX+RX*SIN(A*T+PH))
1040 Y0=INT(CY+RY*SIN(B*T))
1050 FOR T=DT TO 2*PI STEP DT
1060 X1=INT(CX+RX*SIN(A*T+PH))
1070 Y1=INT(CY+RY*SIN(B*T))
1080 LINE (X0,Y0)-(X1,Y1)
1090 X0=X1:Y0=Y1
1100 NEXT T
1110 RETURN
