CLS
W=320
H=320
XMIN=-2
XMAX=1
YMIN=-1.5
YMAX=1.5
MAXITER=16
XS=(XMAX-XMIN)/W
YS=(YMAX-YMIN)/H
GS=255/MAXITER
FOR Y=0 TO H-1
CY=YMIN+YS*Y
FOR X=0 TO W-1
CX=XMIN+XS*X
ZX=0
ZY=0
I=0
DO
T=ZX*ZX-ZY*ZY+CX
ZY=2*ZX*ZY+CY
ZX=T
I=I+1
LOOP UNTIL ZX*ZX>4 OR ZY*ZY>4 OR I>=MAXITER
G=INT(GS*I)
COLOR G,G,G
PSET X,Y
NEXT X
NEXT Y
PRINT 1
END
