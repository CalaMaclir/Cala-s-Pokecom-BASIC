G=7
PRINT FACT(16)
PRINT WRAP$("A")+WRAP$("B")
PRINT G
PRINT ROUNDING()
END
FUNCTION FACT(N)
IF N<=1 THEN
RETURN 1
END IF
RETURN N*FACT(N-1)
END FUNCTION
FUNCTION WRAP$(S$)
GLOBAL G
T$="["+S$+"]"
G=G+1
RETURN T$
END FUNCTION

FUNCTION ROUNDING()
A=1.00000011920928955078125
B=0.99999988079071044921875
C=-1
R=C+A*B
RETURN R=0
END FUNCTION
