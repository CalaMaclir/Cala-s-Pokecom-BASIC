10 CLS
20 W=320:H=320
30 XMIN=-2:XMAX=1
40 YMIN=-1.5:YMAX=1.5
50 MAXITER=16
60 XS=(XMAX-XMIN)/W:YS=(YMAX-YMIN)/H:GS=255/MAXITER
70 FOR Y=0 TO H-1
80 CY=YMIN+YS*Y
90 FOR X=0 TO W-1
100 CX=XMIN+XS*X
110 ZX=0:ZY=0:I=0
120 DO
130 T=ZX*ZX-ZY*ZY+CX:ZY=2*ZX*ZY+CY:ZX=T:I=I+1
140 LOOP UNTIL ZX*ZX>4 OR ZY*ZY>4 OR I>=MAXITER
150 G=INT(GS*I):COLOR G,G,G:PSET X,Y
160 NEXT X
170 NEXT Y
180 PRINT 1
190 END
